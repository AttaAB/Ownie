+"use client";
+
+import { useActionState } from "react";
+import type { ImageFormState } from "@/app/notes/actions";
+
+type Props = {
+  action: (prev: ImageFormState, formData: FormData) => Promise<ImageFormState>;
+  noteId: number;
+};
+
+export default function ImageUploadForm({ action, noteId }: Props) {
+  const [state, formAction, pending] = useActionState(action, {});
+  return (
+    <form action={formAction} className="stack">
+      <input type="hidden" name="id" value={noteId} />
+      <label>
+        Add images (PNG, JPEG, GIF or WebP, up to 5 MB each)
+        <input type="file" name="images" accept="image/png,image/jpeg,image/gif,image/webp" multiple required />
+      </label>
+      {state.error && <p className="error" role="alert">{state.error}</p>}
+      <div className="row">
+        <button type="submit" className="secondary" disabled={pending}>{pending ? "Uploading..." : "Upload"}</button>
+      </div>
+    </form>
+  );
+}
