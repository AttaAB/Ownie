+import { getCurrentUser } from "@/lib/auth";
+import { getOwnedImage, imageResponse } from "@/lib/images";
+
+type Ctx = { params: Promise<{ id: string; imageId: string }> };
+
+// Serves an image to the note's owner only.
+export async function GET(_req: Request, { params }: Ctx) {
+  const user = await getCurrentUser();
+  const { id, imageId } = await params;
+  const noteId = Number(id);
+  const imgId = Number(imageId);
+  if (!user || !Number.isInteger(noteId) || !Number.isInteger(imgId)) return imageResponse(null);
+  return imageResponse(getOwnedImage(user.id, noteId, imgId));
+}
