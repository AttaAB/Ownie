diff --git a/lib/images.ts b/lib/images.ts
new file mode 100644
index 0000000..afb3065
--- /dev/null
+++ b/lib/images.ts
@@ -0,0 +1,113 @@
+import "server-only";
+import { getDb } from "./db";
+
+// Images are stored as BLOBs in SQLite so they live (and get backed up and
+// deleted) together with their note.
+
+export const MAX_IMAGE_BYTES = 5 * 1024 * 1024; // 5 MB per image
+export const MAX_IMAGES_PER_NOTE = 20;
+
+/**
+ * Detects the image type from the file's first bytes rather than trusting the
+ * browser-supplied type. Only raster formats are allowed: SVG can carry
+ * scripts, so it is rejected.
+ */
+export function sniffImageType(bytes: Uint8Array): string | null {
+  const starts = (sig: number[], offset = 0) => sig.every((b, i) => bytes[offset + i] === b);
+  if (starts([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])) return "image/png";
+  if (starts([0xff, 0xd8, 0xff])) return "image/jpeg";
+  if (starts([0x47, 0x49, 0x46, 0x38])) return "image/gif";
+  if (starts([0x52, 0x49, 0x46, 0x46]) && starts([0x57, 0x45, 0x42, 0x50], 8)) return "image/webp";
+  return null;
+}
+
+/** Image ids for a note, oldest first. Callers must already have checked access to the note. */
+export function listImageIds(noteId: number): number[] {
+  const rows = getDb().prepare("SELECT id FROM note_images WHERE note_id = ? ORDER BY id").all(noteId) as {
+    id: number;
+  }[];
+  return rows.map((r) => r.id);
+}
+
+export type AddImagesResult = { error?: string };
+
+/** Adds images to a note the user owns. All-or-nothing: nothing is saved if any file is invalid. */
+export function addImages(userId: number, noteId: number, files: { bytes: Uint8Array }[]): AddImagesResult {
+  const db = getDb();
+  const owned = db.prepare("SELECT 1 FROM notes WHERE id = ? AND user_id = ?").get(noteId, userId);
+  if (!owned) return { error: "Note not found." };
+
+  const prepared: { mime: string; bytes: Uint8Array }[] = [];
+  for (const f of files) {
+    if (f.bytes.byteLength > MAX_IMAGE_BYTES) return { error: "Each image must be 5 MB or smaller." };
+    const mime = sniffImageType(f.bytes);
+    if (!mime) return { error: "Only PNG, JPEG, GIF and WebP images are supported." };
+    prepared.push({ mime, bytes: f.bytes });
+  }
+
+  return db.transaction((): AddImagesResult => {
+    const { count } = db.prepare("SELECT COUNT(*) AS count FROM note_images WHERE note_id = ?").get(noteId) as {
+      count: number;
+    };
+    if (count + prepared.length > MAX_IMAGES_PER_NOTE) {
+      return { error: `A note can have at most ${MAX_IMAGES_PER_NOTE} images.` };
+    }
+    const now = Date.now();
+    const insert = db.prepare("INSERT INTO note_images (note_id, mime_type, data, created_at) VALUES (?, ?, ?, ?)");
+    for (const p of prepared) insert.run(noteId, p.mime, Buffer.from(p.bytes), now);
+    return {};
+  })();
+}
+
+// Note: adding/removing images deliberately doesn't touch notes.updated_at —
+// the edit form is keyed on it, so bumping it would wipe unsaved text edits.
+export function deleteImage(userId: number, noteId: number, imageId: number): boolean {
+  return (
+    getDb()
+      .prepare(
+        `DELETE FROM note_images WHERE id = ? AND note_id = ?
+         AND note_id IN (SELECT id FROM notes WHERE user_id = ?)`,
+      )
+      .run(imageId, noteId, userId).changes > 0
+  );
+}
+
+type ImageData = { mimeType: string; data: Buffer };
+
+/** An image from a note the user owns. */
+export function getOwnedImage(userId: number, noteId: number, imageId: number): ImageData | null {
+  const row = getDb()
+    .prepare(
+      `SELECT i.mime_type AS mimeType, i.data FROM note_images i JOIN notes n ON n.id = i.note_id
+       WHERE i.id = ? AND i.note_id = ? AND n.user_id = ?`,
+    )
+    .get(imageId, noteId, userId) as ImageData | undefined;
+  return row ?? null;
+}
+
+/** An image from a note that is currently shared with this token. */
+export function getSharedImage(token: string, imageId: number): ImageData | null {
+  const row = getDb()
+    .prepare(
+      `SELECT i.mime_type AS mimeType, i.data FROM note_images i JOIN notes n ON n.id = i.note_id
+       WHERE i.id = ? AND n.share_token = ?`,
+    )
+    .get(imageId, token) as ImageData | undefined;
+  return row ?? null;
+}
+
+/** Builds the HTTP response for an image, locked down so it can only ever render as an image. */
+export function imageResponse(image: ImageData | null): Response {
+  if (!image) return new Response("Not found", { status: 404 });
+  return new Response(new Uint8Array(image.data), {
+    headers: {
+      "Content-Type": image.mimeType,
+      "Content-Length": String(image.data.byteLength),
+      "X-Content-Type-Options": "nosniff",
+      "Content-Security-Policy": "default-src 'none'; sandbox",
+      // private + no-cache: revalidate every time so revoking a share link
+      // (or deleting an image) takes effect immediately.
+      "Cache-Control": "private, no-cache",
+    },
+  });
+}
