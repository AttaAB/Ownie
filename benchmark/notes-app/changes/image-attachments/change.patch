+
+export type ImageFormState = { error?: string };
+
+export async function uploadImagesAction(_prev: ImageFormState, formData: FormData): Promise<ImageFormState> {
+  const user = await requireUser();
+  const id = readId(formData);
+  const files = formData.getAll("images").filter((f): f is File => f instanceof File && f.size > 0);
+  if (files.length === 0) return { error: "Choose at least one image." };
+  if (files.some((f) => f.size > images.MAX_IMAGE_BYTES)) return { error: "Each image must be 5 MB or smaller." };
+  const loaded = await Promise.all(files.map(async (f) => ({ bytes: new Uint8Array(await f.arrayBuffer()) })));
+  const result = images.addImages(user.id, id, loaded);
+  if (result.error) return result;
+  revalidatePath(`/notes/${id}`);
+  return {};
+}
+
+export async function deleteImageAction(formData: FormData): Promise<void> {
+  const user = await requireUser();
+  const id = readId(formData);
+  const imageId = Number(formData.get("imageId"));
+  if (Number.isInteger(imageId)) images.deleteImage(user.id, id, imageId);
+  revalidatePath(`/notes/${id}`);
+}
