+def _code_exists(code):
+    return conn.execute("SELECT 1 FROM links WHERE code = ?", (code,)).fetchone() is not None
+
+
+def _to_utc_naive(dt):
+    # Stored timestamps are naive UTC (matching created_at); normalise input to that.
+    if dt.tzinfo is not None:
+        dt = dt.astimezone(timezone.utc).replace(tzinfo=None)
+    return dt
+
+
+def create_link(url, alias=None, expires_at=None):
+    if alias is not None:
+        if not ALIAS_PATTERN.match(alias) or alias.lower() in RESERVED_ALIASES:
+            raise AliasError(
+                "Alias must be 3-32 characters of letters, digits, '-' or '_', "
+                "and not a reserved path"
+            )
+        if _code_exists(alias):
+            raise AliasTakenError("Alias already in use")
+        code = alias
+    else:
+        while True:
+            code = generate_code()
+            if not _code_exists(code):
+                break
+
+    now = datetime.utcnow()
+    expires_str = None
+    if expires_at is not None:
+        expires_at = _to_utc_naive(expires_at)
+        if expires_at <= now:
+            raise ValueError("Expiry date must be in the future")
+        expires_str = expires_at.isoformat()
+
