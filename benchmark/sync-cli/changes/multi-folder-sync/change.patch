+def load_config(path):
+    """Read a JSON config listing the folders to sync.
+
+    {"folders": [{"server": "http://host:8000", "dest": "local/a",
+                  "manifest_path": "/manifest.json", "name": "a"}, ...]}
+
+    Only "server" and "dest" are required. A relative "dest" is resolved
+    against the config file's own directory.
+    """
+    try:
+        with open(path) as f:
+            data = json.load(f)
+    except OSError as exc:
+        raise ConfigError(f"cannot read config {path}: {exc}") from exc
+    except ValueError as exc:
+        raise ConfigError(f"config {path} is not valid JSON: {exc}") from exc
+    entries = data.get("folders") if isinstance(data, dict) else None
+    if not isinstance(entries, list) or not entries:
+        raise ConfigError("config must be an object with a non-empty 'folders' list")
+
+    base = os.path.dirname(os.path.abspath(path))
+    folders = []
+    for i, e in enumerate(entries, 1):
+        if not isinstance(e, dict) or not isinstance(e.get("server"), str) \
+                or not isinstance(e.get("dest"), str) or not e["server"] or not e["dest"]:
+            raise ConfigError(f"folder #{i} needs string 'server' and 'dest' fields")
+        unknown = set(e) - {"server", "dest", "manifest_path", "name"}
+        if unknown:
+            raise ConfigError(f"folder #{i} has unknown field(s): {', '.join(sorted(unknown))}")
+        dest = os.path.join(base, os.path.expanduser(e["dest"]))
+        folders.append(Folder(server=e["server"], dest=os.path.normpath(dest),
+                              manifest_path=e.get("manifest_path") or "/manifest.json",
+                              name=str(e.get("name") or e["dest"])))
+    check_distinct(folders)
+    return folders
+
