+class Job:
+    """Syncs one folder, on its own thread when several run in parallel."""
+
+    def __init__(self, folder, args, parallel, stop):
+        self.folder = folder
+        self.args = args
+        self.stop = stop
+        self.prefix = f"[{folder.name}] " if parallel else ""
+        self.parallel = parallel
+        self.remote = Remote(folder.server, folder.manifest_path, timeout=args.timeout,
+                             retry=RetryPolicy(attempts=args.retries), log=self.log)
+        self.ok = True
+
+    def log(self, msg):
+        # Keep a leading newline/indent readable while adding the folder prefix.
+        log(self.prefix + msg if not msg.startswith("  ") else "  " + self.prefix + msg[2:])
+
+    def sync_once(self):
+        f = self.folder
+        self.log(f"[{stamp()}] syncing {f.server} -> {f.dest}")
+        try:
+            r = run_sync(self.remote, f.dest, dry_run=self.args.dry_run,
+                         allow_empty=self.args.allow_empty, log=self.log,
+                         label=self.prefix, live_progress=not self.parallel,
+                         stop=self.stop)
+        except RemoteError as exc:
+            self.log(f"[{stamp()}] sync failed: {exc}")
+            return False
+        status = "done" if r.ok else f"done with {len(r.failed)} failure(s)"
+        self.log(f"[{stamp()}] {status}: {r.downloaded} downloaded, {r.deleted} deleted, "
+                 f"{r.unchanged} unchanged")
+        return r.ok
+
+    def run(self):
+        try:
+            while not self.stop.is_set():
+                self.ok = self.sync_once()  # a failed cycle is logged; retried next cycle
+                if self.args.once:
+                    return
+                self.stop.wait(self.args.interval)
+        except Exception as exc:  # don't let one folder's bug kill the others silently
+            self.ok = False
+            self.log(f"[{stamp()}] unexpected error: {type(exc).__name__}: {exc}")
 
 
